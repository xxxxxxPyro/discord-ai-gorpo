# Gorpo Discord Bot Configuration
# Copy this file to .env and fill in your actual secrets
# NEVER commit .env to version control!

# REQUIRED: Discord Bot Token (from Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# REQUIRED: Groq API Key (from console.groq.com/keys)
GROQ_API_KEY=

# REQUIRED: Discord Guild (Server) ID for slash command registration
DISCORD_GUILD_ID=1444135183337918599

# OPTIONAL: Groq Model to use (default: openai/gpt-oss-120b)
# Available on free tier: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# OPTIONAL: OpenRouter API Key (fallback provider)
# OPENROUTER_API_KEY=

# OPTIONAL: OpenRouter Model
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ROLE GATE: Set to "true" to restrict bot usage to members with REQUIRED_ROLE
ROLE_GATE=true

# ROLE GATE: Role name (case-insensitive) required to use the bot
REQUIRED_ROLE=gorpos-master

# OPTIONAL: Bot owner Discord User ID (bypasses role gate)
# OWNER_ID=

# LOG LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO